NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
EVENT_PAGE_SIZE=50
SESSION_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_MS=21600000
# Browser traffic stays same-origin; Vite/Nginx proxy /api to the server.
VITE_API_BASE_URL=/api/v1
# Development/preview proxy target. Put overrides in apps/web/.env.local.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
VITE_CESIUM_ION_ACCESS_TOKEN=
TRAIL_SEARCH_API_BASE_URL=https://nominatim.openstreetmap.org/search
TRAIL_MAP_API_BASE_URL=https://api.openstreetmap.org/api/0.6/map
# Weather provider: Open-Meteo Forecast API (not OpenWeatherMap or WeatherAPI).
# Free/non-commercial setup: this public endpoint needs no API key; leave the key empty.
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
# Paid/commercial setup only: get an Open-Meteo Customer API key at
# https://dashboard.open-meteo.com/ and change WEATHER_API_BASE_URL to
# https://customer-api.open-meteo.com/v1/forecast before setting the key below.
WEATHER_API_KEY=
WEATHER_REFRESH_INTERVAL_MS=300000
WEATHER_FRESHNESS_MAX_AGE_MS=1800000
# Route suitability provider: Jev through OpenRouter's Decisions API
# Create a server-side key at https://openrouter.ai/settings/keys
# Scoring is locked to the Jev-only ~typesafe/jev-latest alias in application code.
OPENROUTER_DECISIONS_API_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=ProbablyThisWay
STATE_ADAPTER_TOKEN=
DATABASE_URL=
